[Unit]
Description=PULSE daily public-source refresh worker
Wants=network-online.target
After=network-online.target pulse-api.service

[Service]
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Type=simple
WorkingDirectory=/root/projects/PULSE/website
ExecStart=/root/projects/PULSE/website/.venv/bin/python -m backend.worker
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

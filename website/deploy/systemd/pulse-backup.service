[Unit]
Description=PULSE verified SQLite backup
After=pulse-api.service

[Service]
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Type=oneshot
Restart=on-failure
RestartSec=30min
WorkingDirectory=/root/projects/PULSE/website
ExecStart=/root/projects/PULSE/website/.venv/bin/python -m scripts.backup_databases

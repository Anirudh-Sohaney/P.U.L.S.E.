[Unit]
Description=PULSE local public API
Wants=network-online.target
After=network-online.target

[Service]
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Type=simple
WorkingDirectory=/root/projects/PULSE/website
Environment=API_HOST=127.0.0.1
Environment=API_PORT=8000
ExecStartPre=/root/projects/PULSE/website/.venv/bin/python -m scripts.import_signal_catalog
ExecStartPre=/root/projects/PULSE/website/.venv/bin/python -m scripts.audit_signal_store
ExecStart=/root/projects/PULSE/website/.venv/bin/python -m backend.main
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
